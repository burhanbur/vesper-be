# Application
NODE_ENV=development
APP_NAME=express-starter-kit
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=false

# HTTP
BODY_LIMIT_BYTES=1048576
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_HEADERS_TIMEOUT_MS=16000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# Storage and file processing
FILE_STORAGE_PATH=storage/uploads
FILE_UPLOAD_MAX_BYTES=10485760
FILE_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
EXCEL_IMPORT_MAX_BYTES=5242880
EXCEL_IMPORT_MAX_ROWS=1000
EXCEL_EXPORT_BATCH_SIZE=500

# Infrastructure
DATABASE_URL=postgresql://starter_kit:starter_kit@localhost:5432/express_starter_kit?schema=public
REDIS_URL=redis://localhost:6379
LOG_LEVEL=debug

# API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
API_DOCS_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Authentication
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
AUTH_JWT_ISSUER=express-starter-kit
AUTH_JWT_AUDIENCE=express-starter-kit-api
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=60000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REFRESH_RATE_LIMIT_WINDOW_MS=60000
AUTH_REFRESH_RATE_LIMIT_MAX=30
